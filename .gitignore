# 预处理后的二进制行情数据(约 300MB)，由 preprocess.py 生成，不入库
data/*
!data/meta.json
# 内置 setup 清单是配置不是数据, 必须入库(账本 data/journal.json 仍然忽略)
!data/setups.json
# 日报索引(由 tools/build_reports.py 从 xlsx 生成, 体量小, 需要入库)
!data/reports.json

# 运行期产物
server.log
port.txt
_shot_*.png
_cmp_*.png
_v*_*.png
_z_*.png
_smoke*.js
_perf*.js
_smoke*.py
_cmp*.py
_crop*.py
_api.js
_m[0-9]*.py
_m[0-9]*.js
_g[0-9]*.py
_g[0-9]*.js
_icons_tv*.json

# 工具链
__pycache__/
*.pyc
node_modules/
.DS_Store

# 随手截图/临时脚本(不入库)
_*.png
_*.js
_*.py
reference/_crop*.png
